{
  "sandbox": {
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["localhost", "127.0.0.1", "[::1]"],
      "allowMachLookup": ["com.apple.SystemConfiguration.configd"]
    },
    "excludedCommands": [
      "git *",
      "gh *",
      "cargo nextest run *",
      "cargo run *",
      "mdbook *",
      "./scripts/mutants.sh *",
      "./scripts/ci-watch.sh",
      "./scripts/ci-watch.sh *",
      "prek *"
    ]
  }
}
